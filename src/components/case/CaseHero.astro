---
/**
 * En-tête d'étude de cas : titre et promesse à gauche, une couverture qui
 * montre le projet à droite (photo de terrain, modèle de données ou résultat),
 * puis les chiffres clés. Le premier écran doit suffire à savoir de quoi il s'agit.
 */
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import StarSchema from '../StarSchema.astro';
import MatrixCover from './MatrixCover.astro';
import { ui, t, home, type Lang } from '../../i18n/ui';
import type { Study } from '../../data/case-studies';

interface Props { study: Study; lang: Lang; readMin: number; firstAnchor: string; }
const { study: s, lang, readMin, firstAnchor } = Astro.props;
const projectsAnchor = `${home(lang)}#${lang === 'fr' ? 'projets' : 'projects'}`;
---
<section class="relative isolate overflow-hidden border-b border-rule" aria-labelledby="cs-title">
  <div aria-hidden="true" class="dot-grid absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_80%_75%_at_30%_0%,#000_35%,transparent_100%)]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -top-48 right-[-12%] -z-10 size-[44rem] rounded-full opacity-55 blur-3xl [background:radial-gradient(circle,var(--accent-glow),transparent_62%)]"></div>

  <div class="wrap grid items-center gap-10 pt-10 pb-12 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,.92fr)] lg:gap-x-14 lg:gap-y-12 lg:pt-16">
    <div class="order-1">
      <nav aria-label={lang === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'} class="font-mono text-[.74rem] text-muted">
        <a href={projectsAnchor} class="inline-flex items-center gap-1.5 text-accent-ink no-underline hover:underline">
          <Icon name="arrow-left" class="size-3.5" /> Portfolio
        </a>
        <span aria-hidden="true" class="mx-2">/</span>{t(ui.cs.crumb, lang)}
      </nav>

      <p class="eyebrow mt-7 mb-0">{t(s.kicker, lang)}</p>
      <h1 id="cs-title"
          class="mt-3 mb-0 bg-gradient-to-b from-ink from-35% to-ink/55 bg-clip-text text-[clamp(2.5rem,7vw,4.4rem)] leading-[1] font-semibold tracking-[-.04em] text-transparent">
        {t(s.title, lang)}
      </h1>
      <p class="mt-5 mb-0 max-w-[60ch] text-[clamp(1.02rem,2.2vw,1.14rem)] leading-relaxed text-ink-soft">{t(s.lede, lang)}</p>

      <ul class="m-0 mt-6 flex list-none flex-wrap gap-2 p-0 font-mono text-[.72rem] text-muted">
        <li class="inline-flex items-center gap-1.5 rounded-full border border-rule-strong bg-surface/80 px-3 py-1 backdrop-blur">{t(s.facts.period, lang)}</li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-rule-strong bg-surface/80 px-3 py-1 backdrop-blur">{t(s.facts.team, lang).split(',')[0]}</li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-rule-strong bg-surface/80 px-3 py-1 backdrop-blur">
          <Icon name="file" class="size-3.5" /> {readMin} {t(ui.cs.minutes, lang)}
        </li>
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class="btn btn--primary" href={firstAnchor}>{t(ui.cs.read, lang)} <Icon name="arrow-right" /></a>
        {s.links?.filter((l) => l.href).map((l) => (
          <a class="btn" href={l.href} target="_blank" rel="noopener"><Icon name={l.icon} /> {t(l.label, lang)}</a>
        ))}
      </div>
    </div>

    <div class="relative order-3 mx-auto w-full max-w-[30rem] lg:order-2 lg:max-w-none">
      {s.cover.kind === 'photo' && (
        <figure class="relative m-0 rounded-[1.6rem] p-px [background:linear-gradient(160deg,var(--accent),transparent_45%,var(--rule-strong))] shadow-[0_30px_80px_-30px_var(--accent-glow)]">
          <Picture src={s.cover.image} alt={t(s.cover.alt, lang)}
                   formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720, 900]}
                   sizes="(min-width: 1024px) 500px, 92vw"
                   loading="eager" fetchpriority="high"
                   class="block aspect-[4/5] max-h-[34rem] w-full rounded-[calc(1.6rem-1px)] object-cover object-[50%_35%]" />
          <figcaption class="absolute inset-x-3 bottom-3 rounded-xl border border-white/10 bg-black/55 px-4 py-3 text-[.8rem] leading-snug text-white/85 backdrop-blur-md">
            <b class="block text-[.86rem] font-semibold text-white">{t(s.cover.title, lang)}</b>
            {t(s.cover.caption, lang)}
          </figcaption>
        </figure>
      )}
      {s.cover.kind === 'star' && (
        <figure class="card m-0 p-5 sm:p-6">
          <figcaption class="eyebrow mb-4 text-[.66rem]">{t(ui.cs.starHint, lang)}</figcaption>
          <StarSchema lang={lang} />
        </figure>
      )}
      {s.cover.kind === 'matrix' && <MatrixCover lang={lang} />}
    </div>

    <dl class="order-2 m-0 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-rule bg-rule lg:order-3 lg:col-span-2 lg:grid-cols-4">
      {s.stats.map((st) => (
        <div class="flex flex-col-reverse justify-end bg-surface/85 px-5 py-5 backdrop-blur">
          <dt class="mt-1.5 font-mono text-[.68rem] tracking-[.12em] text-muted uppercase">{t(st.label, lang)}</dt>
          <dd class="m-0 font-mono text-[clamp(1.35rem,3vw,1.8rem)] font-semibold tracking-tight text-accent-ink tabular-nums">{t(st.value, lang)}</dd>
        </div>
      ))}
    </dl>
  </div>

</section>

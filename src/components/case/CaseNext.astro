---
/**
 * Fin d'étude : l'étude suivante en grande carte (jamais d'impasse), puis
 * les deux sorties utiles — revenir aux projets ou écrire.
 */
import Icon from '../Icon.astro';
import { ui, t, home, type Lang } from '../../i18n/ui';
import type { Study } from '../../data/case-studies';

interface Props { next: Study; lang: Lang; }
const { next: n, lang } = Astro.props;
const projectsAnchor = `${home(lang)}#${lang === 'fr' ? 'projets' : 'projects'}`;
---
<section class="relative isolate overflow-hidden border-t border-rule py-16 sm:py-20" aria-labelledby="cs-next">
  <div aria-hidden="true" class="dot-grid absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_70%_80%_at_50%_100%,#000_25%,transparent_80%)]"></div>
  <div class="wrap">
    <p id="cs-next" class="eyebrow m-0 mb-4">{t(ui.cs.next, lang)}</p>
    <a href={n.paths[lang]} class="card group grid items-center gap-6 p-6 text-ink no-underline sm:p-8 md:grid-cols-[minmax(0,1fr)_auto] md:gap-10">
      <div>
        <p class="eyebrow m-0 text-[.66rem]">{t(n.kicker, lang)}</p>
        <p class="mt-2 mb-0 text-[clamp(1.7rem,4vw,2.6rem)] leading-[1.05] font-semibold tracking-[-.03em] text-ink transition-colors group-hover:text-accent-ink">{t(n.title, lang)}</p>
        <p class="mt-3 mb-0 line-clamp-2 max-w-[70ch] text-[.95rem] leading-relaxed text-muted">{t(n.lede, lang)}</p>
        <dl class="m-0 mt-5 flex flex-wrap gap-x-8 gap-y-3">
          {n.stats.slice(0, 3).map((st) => (
            <div class="flex flex-col-reverse">
              <dt class="text-[.74rem] text-muted">{t(st.label, lang)}</dt>
              <dd class="m-0 font-mono text-[1.15rem] font-semibold text-accent-ink tabular-nums">{t(st.value, lang)}</dd>
            </div>
          ))}
        </dl>
      </div>
      <span class="grid size-14 place-items-center justify-self-start rounded-full border border-rule-strong bg-surface-2 text-ink transition-all duration-200 group-hover:translate-x-1 group-hover:border-accent group-hover:bg-accent group-hover:text-[color:var(--on-accent)] md:justify-self-end" aria-hidden="true">
        <Icon name="arrow-right" class="size-5" />
      </span>
    </a>

    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn" href={projectsAnchor}><Icon name="arrow-left" /> {t(ui.cs.back, lang)}</a>
      <a class="btn" href={`${home(lang)}#contact`}><Icon name="mail" /> {t(ui.cs.contact, lang)}</a>
    </div>
  </div>
</section>

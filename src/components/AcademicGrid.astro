---
/**
 * Projets académiques en bento : le projet le plus abouti en carte élargie
 * (avec son étude de cas), les autres avec leurs mesures quand le rapport en donne.
 */
import Icon from './Icon.astro';
import { ui, t, type Lang } from '../i18n/ui';
import { academic } from '../data/projects';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const pct = (v: number) => (lang === 'fr' ? `${v} %` : `${v}%`);
---
<div class="mt-16" data-reveal>
  <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
    <h3 class="m-0 text-xl font-semibold tracking-tight text-ink">{t(ui.project.others, lang)}</h3>
    <p class="m-0 max-w-[52ch] text-[.9rem] text-muted">{t(ui.project.othersLede, lang)}</p>
  </div>
  <ul class="m-0 grid list-none gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
    {academic.map((a) => (
      <li class:list={['card flex flex-col p-5 sm:p-6', a.featured && 'md:col-span-2', a.wide && 'lg:col-span-2 lg:row-span-2']}>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="eyebrow m-0 text-[.64rem]">{t(a.kicker, lang)}</p>
          {a.href && (
            <span class="rounded-full border border-accent/40 bg-accent/10 px-2 py-0.5 font-mono text-[.62rem] tracking-[.08em] text-accent-ink uppercase">
              {t(ui.path.read, lang)}
            </span>
          )}
        </div>
        <h4 class:list={['mt-2.5 mb-0 leading-snug font-semibold tracking-tight text-ink', a.featured ? 'text-[1.25rem]' : 'text-[1.02rem]']}>
          {a.href ? <a href={t(a.href, lang)} class="text-ink no-underline hover:text-accent-ink">{t(a.name, lang)}</a> : t(a.name, lang)}
        </h4>
        <p class:list={['mt-2 mb-0 leading-relaxed text-muted', a.featured ? 'max-w-[62ch] text-[.92rem]' : 'text-[.86rem]']}>{t(a.summary, lang)}</p>

        {a.metrics && (
          <dl class:list={['m-0 mt-5 grid gap-px overflow-hidden rounded-xl border border-rule bg-rule', a.featured ? 'grid-cols-1 sm:grid-cols-3' : 'grid-cols-3']}>
            {a.metrics.map((m) => (
              <div class="flex flex-col-reverse justify-end bg-surface-2/70 px-3 py-2.5">
                <dt class="mt-0.5 text-[.72rem] leading-snug text-muted">{t(m.label, lang)}</dt>
                <dd class:list={['m-0 font-mono font-semibold tracking-tight text-accent-ink tabular-nums', a.featured ? 'text-[1.3rem]' : 'text-[1.05rem]']}>{t(m.value, lang)}</dd>
              </div>
            ))}
          </dl>
        )}

        {a.confusion && (
          <figure class="m-0 mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
            <table class="border-separate border-spacing-1 font-mono text-[.78rem]">
              <thead>
                <tr>
                  <td class="pr-1 text-right text-[.58rem] leading-tight text-muted uppercase">{lang === 'fr' ? 'réel ↓ prédit →' : 'actual ↓ predicted →'}</td>
                  {a.confusion.labels.map((l) => <th scope="col" class="px-1 text-[.6rem] font-normal tracking-[.06em] text-muted uppercase">{t(l, lang)}</th>)}
                </tr>
              </thead>
              <tbody>
                {[0, 1].map((r) => (
                  <tr>
                    <th scope="row" class="pr-1 text-right text-[.6rem] font-normal tracking-[.06em] text-muted uppercase">{t(a.confusion!.labels[r], lang)}</th>
                    {[0, 1].map((c) => (
                      <td class:list={['min-w-16 rounded-md px-2 py-1.5 text-center font-semibold tabular-nums', r === c ? 'bg-accent text-[color:var(--on-accent)]' : 'bg-surface-2 text-ink-soft']}>
                        {a.confusion!.cells[r * 2 + c]}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
            <figcaption class="max-w-[38ch] text-[.78rem] leading-relaxed text-muted">{t(a.confusion.caption, lang)}</figcaption>
          </figure>
        )}

        {a.bars && (
          <figure class="m-0 mt-5">
            <figcaption class="mb-2 font-mono text-[.64rem] tracking-[.12em] text-muted uppercase">{t(a.bars.title, lang)}</figcaption>
            <ul class="m-0 grid list-none gap-1.5 p-0">
              {a.bars.items.map((b) => (
                <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 text-[.78rem]">
                  <span class={b.best ? 'text-ink' : 'text-muted'}>{t(b.label, lang)}</span>
                  <span class:list={['font-mono font-semibold tabular-nums', b.best ? 'text-accent-ink' : 'text-muted']}>{pct(b.value)}</span>
                  <span class="col-span-2 h-1.5 overflow-hidden rounded-full bg-surface-2">
                    <span class:list={['block h-full rounded-full', b.best ? 'bg-accent' : 'bg-rule-strong']} style={`width:${b.value}%`}></span>
                  </span>
                </li>
              ))}
            </ul>
          </figure>
        )}

        {a.note && <p class="mt-3 mb-0 text-[.76rem] leading-relaxed text-muted">{t(a.note, lang)}</p>}

        <div class="mt-auto pt-5">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
              {a.stack.map((s) => (
                <li class="rounded-md border border-rule bg-surface-2 px-2 py-0.5 font-mono text-[.68rem] text-ink-soft">{s}</li>
              ))}
            </ul>
            {a.href && (
              <a class="btn" href={t(a.href, lang)}>{t(ui.project.caseStudy, lang)} <Icon name="arrow-right" /></a>
            )}
          </div>
          <p class="mt-4 mb-0 border-t border-rule pt-3 font-mono text-[.66rem] text-muted">{t(a.context, lang)}</p>
        </div>
      </li>
    ))}
  </ul>
</div>

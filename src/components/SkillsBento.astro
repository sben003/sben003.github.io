---
/**
 * Compétences en bento : trois domaines outillés et une carte de méthodes.
 * Le point devant chaque techno est un fait, pas une note : plein = servi
 * dans un système livré et exploité, creux = projet ou prototype.
 */
import Icon from './Icon.astro';
import { ui, t, type Lang } from '../i18n/ui';
import { domains, practices, type Level } from '../data/skills';
import { cases } from '../data/projects';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const span: Record<string, string> = {
  data: 'lg:col-span-4',
  web: 'lg:col-span-2',
  infra: 'lg:col-span-2',
};
const levelText = (l: Level) => t(l === 'production' ? ui.levels.productionShort : ui.levels.projetShort, lang);
---
<div class="mb-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[.8rem] text-muted" data-reveal>
  <span class="font-mono text-[.66rem] tracking-[.12em] uppercase">{t(ui.levels.legend, lang)}</span>
  <span class="inline-flex items-center gap-2"><span class="pill__lvl pill__lvl--production" aria-hidden="true"></span>{t(ui.levels.production, lang)}</span>
  <span class="inline-flex items-center gap-2"><span class="pill__lvl pill__lvl--projet" aria-hidden="true"></span>{t(ui.levels.projet, lang)}</span>
</div>

<div class="grid gap-4 lg:grid-cols-6">
  {domains.map((d) => (
    <section class:list={['card flex flex-col p-6 sm:p-7', span[d.id]]} aria-labelledby={`sk-${d.id}`} data-reveal>
      <div class="flex items-start gap-4">
        <span class="grid size-10 flex-none place-items-center rounded-xl border border-rule-strong bg-surface-2 text-accent-ink shadow-[0_0_24px_-6px_var(--accent-glow)]">
          <Icon name={d.glyph} class="size-5" />
        </span>
        <div>
          <h3 id={`sk-${d.id}`} class="m-0 text-lg font-semibold tracking-tight text-ink">{t(d.title, lang)}</h3>
          <p class="mt-1 mb-0 text-[.9rem] leading-relaxed text-muted">{t(d.lede, lang)}</p>
        </div>
      </div>

      <div class:list={['mt-6 grid gap-5', d.id === 'data' && 'md:grid-cols-3 md:gap-6']}>
        {d.groups.map((g) => (
          <div>
            <h4 class="m-0 mb-2.5 font-mono text-[.66rem] font-normal tracking-[.12em] text-muted uppercase">{t(g.label, lang)}</h4>
            <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
              {g.items.map((it) => (
                <li class="pill">
                  {it.icon && <svg aria-hidden="true"><use href={`#si-${it.icon}`} /></svg>}
                  {it.name}
                  <span class:list={['pill__lvl', `pill__lvl--${it.level}`]} title={t(ui.levels[it.level], lang)} aria-hidden="true"></span>
                  <span class="sr-only">({levelText(it.level)})</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-auto pt-6">
        <div class="border-t border-dashed border-rule pt-4">
          <p class="m-0 mb-2.5 font-mono text-[.66rem] tracking-[.12em] text-muted uppercase">{t(ui.levels.uses, lang)}</p>
          <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
            {d.uses.map((u) => (
              <li class="rounded-md bg-accent/10 px-2 py-1 text-[.78rem] text-accent-ink">{t(u, lang)}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <section class="card flex flex-col p-6 sm:p-7 lg:col-span-4" aria-labelledby="sk-archi" data-reveal>
    <div class="flex items-start gap-4">
      <span class="grid size-10 flex-none place-items-center rounded-xl border border-rule-strong bg-surface-2 text-accent-ink shadow-[0_0_24px_-6px_var(--accent-glow)]">
        <Icon name="compass" class="size-5" />
      </span>
      <div>
        <h3 id="sk-archi" class="m-0 text-lg font-semibold tracking-tight text-ink">{t(practices.title, lang)}</h3>
        <p class="mt-1 mb-0 text-[.9rem] leading-relaxed text-muted">{t(practices.lede, lang)}</p>
      </div>
    </div>
    <ol class="mt-6 mb-0 grid list-none gap-3 p-0 sm:grid-cols-2">
      {practices.items.map((it, i) => (
        <li class="rounded-xl border border-rule bg-surface-2/60 p-4 transition-colors hover:border-rule-strong">
          <p class="m-0 flex items-baseline gap-2.5 text-[.95rem] font-semibold text-ink">
            <span class="font-mono text-[.7rem] font-normal text-accent-ink">{`0${i + 1}`}</span>{t(it.name, lang)}
          </p>
          <p class="mt-1.5 mb-0 text-[.85rem] leading-relaxed text-muted">{t(it.detail, lang)}</p>
        </li>
      ))}
    </ol>
    <div class="mt-auto pt-6">
    <p class="m-0 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-dashed border-rule pt-4 text-[.82rem] text-muted">
      <span class="font-mono text-[.66rem] tracking-[.12em] uppercase">{t(ui.levels.seen, lang)}</span>
      {cases.map((c) => (
        <a href={t(c.href, lang)} class="inline-flex items-center gap-1 font-medium text-accent-ink no-underline hover:underline">
          {t(c.name, lang)} <Icon name="arrow-up-right" class="size-3.5" />
        </a>
      ))}
    </p>
    </div>
  </section>
</div>

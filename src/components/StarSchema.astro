---
/**
 * Schéma en étoile de l'entrepôt, en miniature : une table de faits, cinq
 * dimensions. Survoler une dimension allume sa jointure ; l'info-bulle native
 * donne ses attributs. Noms et attributs repris tels quels du rapport.
 */
import { type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';

const dims = [
  { name: 'Dim_Colorant', attrs: fr ? 'type · code E · prix unitaire' : 'type · E number · unit price' },
  { name: 'Dim_Temps', attrs: fr ? 'jour · mois · trimestre · année' : 'day · month · quarter · year' },
  { name: 'Dim_Produit', attrs: fr ? 'nom · catégorie' : 'name · category' },
  { name: 'Dim_Fournisseur', attrs: fr ? 'pays · certification' : 'country · certification' },
  { name: 'Dim_Origine', attrs: fr ? 'source · nature' : 'source · nature' },
];

/* Deux mises en page : en étoile sur écran large, en colonne sur mobile
   (le texte y garde une taille lisible). */
const layouts = [
  { key: 'wide', cls: 'hidden sm:block', viewBox: '0 0 460 278', fact: { x: 146, y: 96, w: 168 }, dims: [
    { x: 166, y: 6, w: 128, link: 'M230 50 V96' },
    { x: 2, y: 56, w: 128, link: 'M130 78 L150 118' },
    { x: 330, y: 56, w: 128, link: 'M330 78 L310 118' },
    { x: 2, y: 230, w: 128, link: 'M130 252 L150 200' },
    { x: 330, y: 230, w: 128, link: 'M330 252 L310 200' },
  ] },
  { key: 'tall', cls: 'block sm:hidden', viewBox: '0 0 300 302', fact: { x: 46, y: 124, w: 208 }, dims: [
    { x: 86, y: 4, w: 128, link: 'M150 48 V124' },
    { x: 4, y: 62, w: 136, link: 'M72 106 V124' },
    { x: 160, y: 62, w: 136, link: 'M228 106 V124' },
    { x: 4, y: 258, w: 136, link: 'M72 258 V240' },
    { x: 160, y: 258, w: 136, link: 'M228 258 V240' },
  ] },
];
const measures = fr
  ? ['sum · quantité (kg)', 'sum · montant (€)', 'avg · score santé', 'avg · score env.']
  : ['sum · quantity (kg)', 'sum · amount (€)', 'avg · health score', 'avg · env. score'];
---
{layouts.map((L) => (
  <svg class:list={['star h-auto w-full', L.cls]} viewBox={L.viewBox} role="img" aria-labelledby={`star-t-${lang}-${L.key}`}>
    <title id={`star-t-${lang}-${L.key}`}>{fr
      ? 'Schéma en étoile : la table Faits_Ventes_Colorants reliée à cinq dimensions — Colorant, Temps, Produit, Fournisseur, Origine.'
      : 'Star schema: the Faits_Ventes_Colorants table joined to five dimensions — Colorant, Temps, Produit, Fournisseur, Origine.'}</title>
    {L.dims.map((d, i) => (
      <g class="star__dim">
        <title>{dims[i].name} — {dims[i].attrs}</title>
        <path class="star__link" d={d.link} />
        <rect class="star__box" x={d.x} y={d.y} width={d.w} height="44" rx="8" />
        <text class="star__name" x={d.x + d.w / 2} y={d.y + 26.5} text-anchor="middle">{dims[i].name}</text>
      </g>
    ))}
    <g>
      <rect class="star__fact" x={L.fact.x} y={L.fact.y} width={L.fact.w} height="116" rx="10" />
      <text class="star__kicker" x={L.fact.x + L.fact.w / 2} y={L.fact.y + 21} text-anchor="middle">{fr ? 'TABLE DE FAITS' : 'FACT TABLE'}</text>
      <text class="star__fact-name" x={L.fact.x + L.fact.w / 2} y={L.fact.y + 39} text-anchor="middle">Faits_Ventes_Colorants</text>
      {measures.map((m, i) => (
        <text class="star__measure" x={L.fact.x + L.fact.w / 2} y={L.fact.y + 60 + i * 15} text-anchor="middle">{m}</text>
      ))}
    </g>
  </svg>
))}

<style>
  .star { font-family: var(--font-mono); }
  .star__link { fill: none; stroke: var(--rule-strong); stroke-width: 1.25; stroke-dasharray: 3 3; transition: stroke .2s ease; }
  .star__box { fill: var(--surface-2); stroke: var(--rule-strong); stroke-width: 1; transition: stroke .2s ease, fill .2s ease; }
  .star__name { fill: var(--ink-soft); font-size: 12.5px; transition: fill .2s ease; }
  .star__fact { fill: var(--accent-wash); stroke: var(--accent); stroke-width: 1.25; }
  .star__kicker { fill: var(--accent-ink); font-size: 9px; letter-spacing: .12em; font-weight: 600; }
  .star__fact-name { fill: var(--ink); font-size: 11.5px; font-weight: 600; }
  .star__measure { fill: var(--muted); font-size: 10.5px; }
  .star__dim { cursor: default; }
  .star__dim:hover .star__link { stroke: var(--accent); stroke-dasharray: none; }
  .star__dim:hover .star__box { stroke: var(--accent); fill: var(--accent-wash); }
  .star__dim:hover .star__name { fill: var(--ink); }
</style>

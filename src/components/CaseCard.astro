---
/**
 * Carte d'étude de cas, lue par impact : problème → réponse → rôle → résultats.
 * Colonne de droite : un aperçu qu'on peut manipuler (vraie série de mesures
 * pour Vigie Océan, schéma en étoile pour l'entrepôt), les résultats mesurés
 * et la chaîne de traitement. L'architecture complète s'ouvre en modale.
 */
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import StarSchema from './StarSchema.astro';
import { ui, t, type Lang } from '../i18n/ui';
import type { CaseProject } from '../data/projects';

interface Props { project: CaseProject; lang: Lang; index: number; }
const { project: p, lang, index } = Astro.props;

const charts = import.meta.glob<string>('../content/charts/*.html', { query: '?raw', import: 'default', eager: true });
const diagrams = import.meta.glob<string>('../content/diagrams/*.html', { query: '?raw', import: 'default', eager: true });
const spark = charts[`../content/charts/spark.${lang}.html`];
const diagram = diagrams[`../content/diagrams/${p.diagram}.${lang}.html`];

const titleId = `case-${p.id}`;
const dialogId = `arch-${p.id}`;
const steps = [
  { label: ui.project.problem, body: p.problem },
  { label: ui.project.solution, body: p.solution },
  { label: ui.project.role, body: p.role },
];
const live = p.id === 'vigie-ocean';
---
<article class="card overflow-hidden" aria-labelledby={titleId} data-reveal>
  <div class="grid lg:grid-cols-[minmax(0,1.08fr)_minmax(0,.92fr)]">

    <!-- Récit -->
    <div class="flex flex-col p-6 sm:p-8 lg:p-10">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="font-mono text-[.7rem] text-muted">{String(index).padStart(2, '0')}</span>
        <span class="inline-flex items-center gap-2 rounded-full border border-rule-strong bg-surface-2 px-2.5 py-1 font-mono text-[.66rem] tracking-[.08em] text-ink-soft uppercase">
          <span class:list={['size-1.5 rounded-full', live ? 'bg-accent shadow-[0_0_0_3px_var(--accent-wash)]' : 'border border-muted']} aria-hidden="true"></span>
          {t(p.status, lang)}
        </span>
        <span class="eyebrow">{t(p.kicker, lang)}</span>
      </div>

      <h3 id={titleId} class="mt-5 mb-0 text-[clamp(1.9rem,4vw,2.6rem)] leading-[1.02] font-semibold tracking-[-.035em] text-ink">{t(p.name, lang)}</h3>
      <p class="mt-2.5 mb-0 text-[1.08rem] leading-snug font-medium text-ink-soft">{t(p.headline, lang)}</p>
      <p class="mt-3 mb-0 font-mono text-[.72rem] leading-relaxed text-muted">{t(p.context, lang)}</p>

      <dl class="mt-8 mb-0 grid gap-5">
        {steps.map((s, i) => (
          <div class="grid gap-1.5 border-l border-rule pl-4 transition-colors hover:border-accent">
            <dt class="font-mono text-[.68rem] tracking-[.12em] text-accent-ink uppercase">{`0${i + 1}`} · {t(s.label, lang)}</dt>
            <dd class="m-0 text-[.95rem] leading-relaxed text-ink-soft">{t(s.body, lang)}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-auto pt-8">
        <p class="m-0 mb-3 font-mono text-[.68rem] tracking-[.12em] text-muted uppercase">{t(ui.project.flow, lang)}</p>
        <ol class="m-0 flex list-none flex-wrap items-center gap-y-2 p-0 font-mono text-[.72rem]">
          {p.pipeline.map((step, i) => (
            <li class="flex items-center">
              <span class="rounded-md border border-rule bg-surface-2 px-2 py-1 text-ink-soft">{t(step, lang)}</span>
              {i < p.pipeline.length - 1 && <span class="mx-1.5 text-muted/70" aria-hidden="true">→</span>}
            </li>
          ))}
        </ol>
      </div>

    </div>

    <!-- Preuves -->
    <div class="flex flex-col gap-7 border-t border-rule bg-bg-alt/70 p-6 sm:p-8 lg:border-t-0 lg:border-l lg:p-10">
      <figure class="m-0">
        <figcaption class="mb-3 flex items-center gap-2 font-mono text-[.68rem] tracking-[.1em] text-muted uppercase">
          <Icon name="activity" class="size-3.5 text-accent-ink" />
          {live ? t(ui.project.realData, lang) : t(ui.project.starHint, lang)}
        </figcaption>
        <div class="relative rounded-xl border border-rule bg-surface p-3 sm:p-4" data-chart>
          {live ? <Fragment set:html={spark} /> : <StarSchema lang={lang} />}
        </div>
      </figure>

      <div>
        <p class="m-0 mb-3 font-mono text-[.68rem] tracking-[.12em] text-muted uppercase">{t(ui.project.results, lang)}</p>
        <dl class="m-0 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-rule bg-rule">
          {p.results.map((r) => (
            <div class="flex flex-col-reverse justify-end bg-surface px-4 py-3.5">
              <dt class="mt-1 text-[.8rem] leading-snug text-muted">{t(r.label, lang)}</dt>
              <dd class="m-0 font-mono text-[1.35rem] leading-tight font-semibold tracking-tight text-accent-ink tabular-nums">{t(r.value, lang)}</dd>
            </div>
          ))}
        </dl>
      </div>


      <div>
        <p class="m-0 mb-3 font-mono text-[.68rem] tracking-[.12em] text-muted uppercase">{t(ui.project.stack, lang)}</p>
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {p.stack.map((s) => (
            <li class="pill">
              {s.icon && <BrandIcon slug={s.icon} />}
              {s.name}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <footer class="flex flex-col gap-4 border-t border-rule px-6 py-5 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:px-8 lg:px-10">
    <div class="flex flex-wrap gap-2.5">
      <a class="btn btn--primary" href={t(p.href, lang)}>{t(ui.project.caseStudy, lang)} <Icon name="arrow-right" /></a>
      <button type="button" class="btn" data-dialog-open={dialogId} aria-haspopup="dialog">
        <Icon name="layers" /> {t(ui.project.architecture, lang)}
      </button>
      {p.extra && (
        <a class="btn" href={p.extra.href} target="_blank" rel="noopener">
          <Icon name={p.extra.icon} /> {t(p.extra.label, lang)}
        </a>
      )}
    </div>
    {p.note && (
      <p class="m-0 inline-flex items-center gap-2 text-[.8rem] text-muted">
        <Icon name="lock" class="size-3.5 flex-none" /> {t(p.note, lang)}
      </p>
    )}
  </footer>
</article>

<dialog id={dialogId} class="modal overflow-auto" aria-labelledby={`${dialogId}-t`}>
  <div class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-rule bg-surface/95 px-5 py-4 backdrop-blur sm:px-6">
    <div>
      <p class="eyebrow m-0">{t(p.name, lang)}</p>
      <h4 id={`${dialogId}-t`} class="mt-1 mb-0 text-lg font-semibold tracking-tight text-ink">{t(ui.project.archTitle, lang)}</h4>
    </div>
    <button type="button" class="btn btn--icon" data-dialog-close aria-label={t(ui.project.close, lang)}><Icon name="x" /></button>
  </div>
  <div class="cs px-4 pt-5 pb-1 sm:px-6" set:html={diagram} />
  <div class="flex justify-end border-t border-rule px-5 py-4 sm:px-6">
    <a class="btn" href={t(p.href, lang)}>{t(ui.project.caseStudy, lang)} <Icon name="arrow-right" /></a>
  </div>
</dialog>

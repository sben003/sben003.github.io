---
/**
 * Page d'étude de cas. Le contenu éditorial vit en HTML dans
 * src/content/case-studies/ ; chaque « <!-- chart:NOM --> » y est remplacé par
 * le graphique généré (scripts/charts.py) dans la langue de la page.
 */
import Base from '../layouts/Base.astro';
import meta from '../content/case-studies/meta.json';
import type { Lang } from '../i18n/ui';

export type Slug = 'vigie-ocean' | 'entrepot-donnees';

interface Props { slug: Slug; lang: Lang; }
const { slug, lang } = Astro.props;

const paths: Record<Slug, Record<Lang, string>> = {
  'vigie-ocean': { fr: '/vigie-ocean/', en: '/en/vigie-ocean/' },
  'entrepot-donnees': { fr: '/entrepot-donnees/', en: '/en/data-warehouse/' },
};

const pages = import.meta.glob<string>('../content/case-studies/*.html', { query: '?raw', import: 'default', eager: true });
const charts = import.meta.glob<string>('../content/charts/*.html', { query: '?raw', import: 'default', eager: true });

const source = pages[`../content/case-studies/${slug}.${lang}.html`];
const html = source.replace(/<!-- chart:([a-z]+) -->/g, (_, name: string) => {
  const chart = charts[`../content/charts/${name}.${lang}.html`];
  if (!chart) throw new Error(`Graphique introuvable : ${name}.${lang}.html (lancer « npm run charts »)`);
  return chart;
});

const m = (meta as Record<string, { title: string; description: string; ogDescription: string; nav: { href: string; label: string }[] }>)[`${slug}.${lang}`];
const other: Lang = lang === 'fr' ? 'en' : 'fr';
---
<Base lang={lang} title={m.title} description={m.description} ogDescription={m.ogDescription}
      path={paths[slug][lang]} altPath={paths[slug][other]} nav={m.nav} ogType="article" progress>
  <div class="cs relative isolate">
    <div aria-hidden="true" class="dot-grid absolute inset-x-0 top-0 -z-10 h-[44rem] [mask-image:radial-gradient(ellipse_75%_65%_at_50%_0%,#000_35%,transparent_100%)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-48 right-[-8%] -z-10 size-[38rem] rounded-full opacity-50 blur-3xl [background:radial-gradient(circle,var(--accent-glow),transparent_62%)]"></div>
    <Fragment set:html={html} />
  </div>
</Base>

---
import Icon from './Icon.astro';
import { ui, t, home, type Lang } from '../i18n/ui';
import type { NavItem } from '../layouts/Base.astro';

interface Props { lang: Lang; nav: NavItem[]; altPath: string; }
const { lang, nav, altPath } = Astro.props;
---
<header class="sticky top-0 z-50 border-b border-rule/70 bg-bg/70 backdrop-blur-xl supports-[backdrop-filter]:bg-bg/60">
  <div class="wrap flex h-16 items-center gap-4">
    <a href={home(lang)} class="group mr-auto flex shrink-0 md:mr-0 items-center gap-2.5 text-sm font-semibold tracking-tight text-ink no-underline">
      <span class="grid size-8 place-items-center rounded-lg border border-rule-strong bg-surface font-mono text-[.72rem] text-accent-ink transition-colors group-hover:border-accent">SB</span>
      <span class="hidden sm:inline">Salem Benzineh</span>
    </a>

    <!-- Desktop : liste en ligne, défilable si elle dépasse (auto-marges : rien d'inatteignable). -->
    <nav class="hidden min-w-0 flex-1 overflow-x-auto [scrollbar-width:none] md:block [&::-webkit-scrollbar]:hidden" aria-label={t(ui.navLabel, lang)} data-nav>
      <ul class="mx-auto flex w-max items-center gap-1 whitespace-nowrap">
        {nav.map((item) => (
          <li>
            <a href={item.href}
               class="block rounded-md px-3 py-2 text-[.84rem] text-muted no-underline transition-colors hover:bg-surface-2 hover:text-ink aria-[current]:text-accent-ink">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <p class="m-0 flex overflow-hidden rounded-lg border border-rule-strong font-mono text-[.7rem] tracking-wider" aria-label={t(ui.langLabel, lang)}>
        {lang === 'fr'
          ? <><span aria-current="true" lang="fr" class="bg-ink px-2 py-1.5 font-semibold text-bg">FR</span><a href={altPath} hreflang="en" lang="en" class="px-2 py-1.5 text-muted no-underline hover:text-ink">EN</a></>
          : <><a href={altPath} hreflang="fr" lang="fr" class="px-2 py-1.5 text-muted no-underline hover:text-ink">FR</a><span aria-current="true" lang="en" class="bg-ink px-2 py-1.5 font-semibold text-bg">EN</span></>}
      </p>
      {nav.length > 0 && (
        <button type="button" popovertarget="menu-mobile" aria-label={t(ui.menu, lang)}
                class="grid size-8 place-items-center rounded-lg border border-rule-strong bg-transparent text-muted transition-colors hover:border-accent hover:text-accent-ink md:hidden">
          <Icon name="menu" />
        </button>
      )}
      <!-- Place réservée dès le premier rendu (pas de décalage) ; visible seulement
           si le JavaScript tourne, puisque c'est lui qui fait basculer le thème. -->
      <button type="button" data-theme-toggle
              data-label-dark={t(ui.themeToDark, lang)} data-label-light={t(ui.themeToLight, lang)}
              class="invisible [.js_&]:visible grid size-8 place-items-center rounded-lg border border-rule-strong bg-transparent text-muted transition-colors hover:border-accent hover:text-accent-ink">
        <span class="[:root[data-theme=light]_&]:hidden"><Icon name="sun" /></span>
        <span class="hidden [:root[data-theme=light]_&]:block"><Icon name="moon" /></span>
      </button>
    </div>
  </div>

  <!-- Mobile : panneau natif (attribut popover), fermé au clic extérieur ou sur Échap. -->
  {nav.length > 0 && (
    <nav id="menu-mobile" popover aria-label={t(ui.navLabel, lang)} data-nav
         class="m-0 mt-16 w-full max-w-none border-0 border-b border-rule bg-bg/95 p-0 text-ink shadow-2xl backdrop-blur-xl [inset:0_0_auto_0] md:hidden">
      <ul class="wrap grid gap-1 py-3">
        {nav.map((item) => (
          <li>
            <a href={item.href} data-menu-close
               class="block rounded-lg px-3 py-3 text-[.95rem] text-ink-soft no-underline transition-colors hover:bg-surface-2 hover:text-ink aria-[current]:text-accent-ink">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</header>

---
/**
 * Bibliothèque de symboles SVG des marques utilisées sur la page.
 * Chaque tracé n'est écrit qu'une fois ; les pills y renvoient par <use>.
 */
import { brandIcons } from '../data/brand-icons';

interface Props { slugs: string[]; }
const unique = [...new Set(Astro.props.slugs)].filter((s) => s in brandIcons).sort();
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    {unique.map((s) => (
      <symbol id={`si-${s}`} viewBox="0 0 24 24"><path d={brandIcons[s].d} /></symbol>
    ))}
  </defs>
</svg>
